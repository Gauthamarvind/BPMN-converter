<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Process_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Process2BPMN" exporterVersion="1.0.0">
  <bpmn:collaboration id="Collaboration_Process_1">
    <bpmn:participant id="Participant_1" name="Sample Interview Transcript" processRef="Process_1"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_1" name="Sample Interview Transcript" isExecutable="false">
    <bpmn:documentation>Generated from: Sample Interview Transcript</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_Process_1">
      <bpmn:lane id="Lane_1" name="Finance Lead (Sarah)">
        <bpmn:flowNodeRef>Event_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="Interviewer">
        <bpmn:flowNodeRef>Activity_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_9</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_3" name="Sarah">
        <bpmn:flowNodeRef>Activity_6</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_4" name="it skips managerial approval and goes directly to the Automated Accounting Bot">
        <bpmn:flowNodeRef>Activity_4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_5" name="they authorize the payment">
        <bpmn:flowNodeRef>Activity_10</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_6" name="they must provide a reason">
        <bpmn:flowNodeRef>Activity_8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Event_start" name="Start">
      <bpmn:outgoing>Flow_Event_start_Activity_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Activity_1" name="Can you walk me through what happens when an employee submit">
      <bpmn:documentation>Interviewer: Can you walk me through what happens when an employee submits a new business travel expense report?</bpmn:documentation>
      <bpmn:incoming>Flow_Event_start_Activity_1</bpmn:incoming>
      <bpmn:outgoing>Flow_Activity_1_Activity_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_2" name="Sure. The employee logs into the expense portal and uploads ">
      <bpmn:documentation>Finance Lead (Sarah): Sure. The employee logs into the expense portal and uploads all itemized receipts along with the business purpose. Once submitted, the portal automatically verifies if the total is under $500.</bpmn:documentation>
      <bpmn:incoming>Flow_Activity_1_Activity_2</bpmn:incoming>
      <bpmn:outgoing>Flow_Activity_2_Activity_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_3" name="What if it's under $500?">
      <bpmn:documentation>Interviewer: What if it's under $500?</bpmn:documentation>
      <bpmn:incoming>Flow_Activity_2_Activity_3</bpmn:incoming>
      <bpmn:outgoing>Flow_Activity_3_Activity_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="Activity_4" name="which runs a policy compliance check. If the policy check passes">
      <bpmn:documentation>Sarah: If the expense is less than or equal to $500, it skips managerial approval and goes directly to the Automated Accounting Bot, which runs a policy compliance check. If the policy check passes, the accounting system schedules an automated bank transfer and emails the payment confirmation to the employee. If the policy check flags any issues, it gets routed to a Senior Financial Auditor for manual audit.</bpmn:documentation>
      <bpmn:incoming>Flow_Activity_3_Activity_4</bpmn:incoming>
      <bpmn:outgoing>Flow_Activity_4_Activity_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="Activity_5" name="And what if the amount exceeds $500?">
      <bpmn:documentation>Interviewer: And what if the amount exceeds $500?</bpmn:documentation>
      <bpmn:incoming>Flow_Activity_4_Activity_5</bpmn:incoming>
      <bpmn:outgoing>Flow_Activity_5_Activity_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_6" name="If the amount is greater than $500, the system routes the ex">
      <bpmn:documentation>Sarah: If the amount is greater than $500, the system routes the expense report to the Employee's Direct Department Manager. The manager has 3 business days to review the receipts and justify the business need.</bpmn:documentation>
      <bpmn:incoming>Flow_Activity_5_Activity_6</bpmn:incoming>
      <bpmn:outgoing>Flow_Activity_6_Activity_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_7" name="What decisions can the manager make?">
      <bpmn:documentation>Interviewer: What decisions can the manager make?</bpmn:documentation>
      <bpmn:incoming>Flow_Activity_6_Activity_7</bpmn:incoming>
      <bpmn:outgoing>Flow_Activity_7_Activity_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_8" name="and a rejection notification is sent back to the employee. If the manager approves">
      <bpmn:documentation>Sarah: The manager can either approve or reject. If the manager rejects the claim, they must provide a reason, and a rejection notification is sent back to the employee. If the manager approves, it then moves forward to the Senior Financial Auditor for final audit.</bpmn:documentation>
      <bpmn:incoming>Flow_Activity_7_Activity_8</bpmn:incoming>
      <bpmn:outgoing>Flow_Activity_8_Activity_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_9" name="What does the Senior Financial Auditor do?">
      <bpmn:documentation>Interviewer: What does the Senior Financial Auditor do?</bpmn:documentation>
      <bpmn:incoming>Flow_Activity_8_Activity_9</bpmn:incoming>
      <bpmn:outgoing>Flow_Activity_9_Activity_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_10" name="triggering the Accounts Payable department to release the funds and notify the employee. If not a...">
      <bpmn:documentation>Sarah: The auditor verifies tax compliance and receipts. If everything is verified, they authorize the payment, triggering the Accounts Payable department to release the funds and notify the employee. If not approved by the auditor, it is returned to the employee for resubmission with updated documentation.</bpmn:documentation>
      <bpmn:incoming>Flow_Activity_9_Activity_10</bpmn:incoming>
      <bpmn:outgoing>Flow_Activity_10_Event_end</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="Event_end" name="End">
      <bpmn:incoming>Flow_Activity_10_Event_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Event_start_Activity_1" sourceRef="Event_start" targetRef="Activity_1"/>
    <bpmn:sequenceFlow id="Flow_Activity_1_Activity_2" sourceRef="Activity_1" targetRef="Activity_2"/>
    <bpmn:sequenceFlow id="Flow_Activity_2_Activity_3" sourceRef="Activity_2" targetRef="Activity_3"/>
    <bpmn:sequenceFlow id="Flow_Activity_3_Activity_4" sourceRef="Activity_3" targetRef="Activity_4"/>
    <bpmn:sequenceFlow id="Flow_Activity_4_Activity_5" sourceRef="Activity_4" targetRef="Activity_5"/>
    <bpmn:sequenceFlow id="Flow_Activity_5_Activity_6" sourceRef="Activity_5" targetRef="Activity_6"/>
    <bpmn:sequenceFlow id="Flow_Activity_6_Activity_7" sourceRef="Activity_6" targetRef="Activity_7"/>
    <bpmn:sequenceFlow id="Flow_Activity_7_Activity_8" sourceRef="Activity_7" targetRef="Activity_8"/>
    <bpmn:sequenceFlow id="Flow_Activity_8_Activity_9" sourceRef="Activity_8" targetRef="Activity_9"/>
    <bpmn:sequenceFlow id="Flow_Activity_9_Activity_10" sourceRef="Activity_9" targetRef="Activity_10"/>
    <bpmn:sequenceFlow id="Flow_Activity_10_Event_end" sourceRef="Activity_10" targetRef="Event_end"/>
  </bpmn:process>
