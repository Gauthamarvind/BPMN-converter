# ==============================================================================
# Process2BPMN Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Non-LLM & Application Settings
# ------------------------------------------------------------------------------
# SINGLE_POOL: When true, merges multiple swimlanes into a single BPMN collaboration pool.
SINGLE_POOL=true

# Server & Dev ports
PORT=8000
VITE_PORT=3000
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 2. LLM Provider Configuration
# ------------------------------------------------------------------------------
# Active provider: ollama | openai_compatible | anthropic | gemini | mock
LLM_PROVIDER=ollama

# ------------------------------------------------------------------------------
# Provider: Ollama (Default - Offline & Local)
# ------------------------------------------------------------------------------
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_AUTH_HEADER=Authorization
# LLM_CONTEXT_TOKENS=8192
# LLM_MAX_OUTPUT_TOKENS=4096
# LLM_TEMPERATURE=0.1

# ------------------------------------------------------------------------------
# Provider: OpenAI / OpenAI-Compatible (OpenAI, Groq, OpenRouter, vLLM, LM Studio)
# ------------------------------------------------------------------------------
# LLM_PROVIDER=openai_compatible
# LLM_MODEL=gpt-4o
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-proj-your-openai-api-key
# LLM_AUTH_HEADER=Authorization
# LLM_CONTEXT_TOKENS=16384
# LLM_MAX_OUTPUT_TOKENS=4096
# LLM_TEMPERATURE=0.1

# ------------------------------------------------------------------------------
# Provider: Azure OpenAI
# ------------------------------------------------------------------------------
# LLM_PROVIDER=openai_compatible
# LLM_MODEL=gpt-4o
# LLM_BASE_URL=https://your-resource-name.openai.azure.com/openai/deployments/your-deployment-name/chat/completions?api-version=2024-02-15-preview
# LLM_API_KEY=your-azure-api-key
# LLM_AUTH_HEADER=api-key
# LLM_CONTEXT_TOKENS=16384
# LLM_MAX_OUTPUT_TOKENS=4096
