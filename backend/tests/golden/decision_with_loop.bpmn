<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Process_Decision_With_Loop" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Process2BPMN" exporterVersion="1.0.0">
  <bpmn:collaboration id="Collaboration_Process_Decision_With_Loop">
    <bpmn:participant id="Pool_Decision_With_Loop" name="Decision With Loop" processRef="Process_Decision_With_Loop"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_Decision_With_Loop" name="Decision With Loop" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Process_Decision_With_Loop">
      <bpmn:lane id="Lane_Author" name="Author">
        <bpmn:flowNodeRef>StartEvent_Decision_With_Loop</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_3_auto</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Reviewer" name="Reviewer">
        <bpmn:flowNodeRef>Gateway_2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_Decision_With_Loop" name="Start">
      <bpmn:outgoing>Flow_start_to_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_1" name="Draft document">
      <bpmn:incoming>Flow_start_to_1</bpmn:incoming>
      <bpmn:incoming>Flow_2_no_to_1</bpmn:incoming>
      <bpmn:outgoing>Flow_1_to_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_2" name="Approved?">
      <bpmn:incoming>Flow_1_to_2</bpmn:incoming>
      <bpmn:outgoing>Flow_2_yes_to_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_2_no_to_1</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_3" name="Publish document">
      <bpmn:incoming>Flow_2_yes_to_3</bpmn:incoming>
      <bpmn:outgoing>Flow_3_to_EndEvent_3_auto</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_3_auto" name="End">
      <bpmn:incoming>Flow_3_to_EndEvent_3_auto</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_start_to_1" sourceRef="StartEvent_Decision_With_Loop" targetRef="Task_1"/>
    <bpmn:sequenceFlow id="Flow_1_to_2" sourceRef="Task_1" targetRef="Gateway_2"/>
    <bpmn:sequenceFlow id="Flow_2_yes_to_3" sourceRef="Gateway_2" targetRef="Task_3" name="Yes">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Yes</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_2_no_to_1" sourceRef="Gateway_2" targetRef="Task_1" name="No">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">No</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_3_to_EndEvent_3_auto" sourceRef="Task_3" targetRef="EndEvent_3_auto"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Process_Decision_With_Loop">
    <bpmndi:BPMNPlane id="BPMNPlane_Process_Decision_With_Loop" bpmnElement="Collaboration_Process_Decision_With_Loop">
      <bpmndi:BPMNShape id="BPMNShape_Pool_Decision_With_Loop" bpmnElement="Pool_Decision_With_Loop" isHorizontal="true">
        <dc:Bounds x="140.0" y="80.0" width="1280.0" height="460.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Lane_Author" bpmnElement="Lane_Author" isHorizontal="true">
        <dc:Bounds x="170.0" y="80.0" width="1250.0" height="280.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Lane_Reviewer" bpmnElement="Lane_Reviewer" isHorizontal="true">
        <dc:Bounds x="170.0" y="360.0" width="1250.0" height="180.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_StartEvent_Decision_With_Loop" bpmnElement="StartEvent_Decision_With_Loop">
        <dc:Bounds x="220.0" y="202.0" width="36.0" height="36.0"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="195.0" y="244.0" width="86.0" height="24.0"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Task_1" bpmnElement="Task_1">
        <dc:Bounds x="760.0" y="125.0" width="100.0" height="80.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Gateway_2" bpmnElement="Gateway_2">
        <dc:Bounds x="580.0" y="425.0" width="50.0" height="50.0"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="560.0" y="401.0" width="90.0" height="20.0"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Task_3" bpmnElement="Task_3">
        <dc:Bounds x="760.0" y="235.0" width="100.0" height="80.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_EndEvent_3_auto" bpmnElement="EndEvent_3_auto">
        <dc:Bounds x="940.0" y="202.0" width="36.0" height="36.0"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="915.0" y="244.0" width="86.0" height="24.0"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_start_to_1" bpmnElement="Flow_start_to_1">
        <di:waypoint x="256.0" y="220.0"/>
        <di:waypoint x="508.0" y="220.0"/>
        <di:waypoint x="508.0" y="165.0"/>
        <di:waypoint x="760.0" y="165.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_1_to_2" bpmnElement="Flow_1_to_2">
        <di:waypoint x="810.0" y="205.0"/>
        <di:waypoint x="810.0" y="510.0"/>
        <di:waypoint x="605.0" y="510.0"/>
        <di:waypoint x="605.0" y="475.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_2_yes_to_3" bpmnElement="Flow_2_yes_to_3">
        <di:waypoint x="630.0" y="450.0"/>
        <di:waypoint x="695.0" y="450.0"/>
        <di:waypoint x="695.0" y="275.0"/>
        <di:waypoint x="760.0" y="275.0"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="665.0" y="257.0" width="60.0" height="16.0"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_2_no_to_1" bpmnElement="Flow_2_no_to_1">
        <di:waypoint x="630.0" y="450.0"/>
        <di:waypoint x="695.0" y="450.0"/>
        <di:waypoint x="695.0" y="165.0"/>
        <di:waypoint x="760.0" y="165.0"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="665.0" y="147.0" width="60.0" height="16.0"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_3_to_EndEvent_3_auto" bpmnElement="Flow_3_to_EndEvent_3_auto">
        <di:waypoint x="860.0" y="275.0"/>
        <di:waypoint x="900.0" y="275.0"/>
        <di:waypoint x="900.0" y="220.0"/>
        <di:waypoint x="940.0" y="220.0"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
