    <bpmn:startEvent id="Event_start" name="Start">
      <bpmn:outgoing>Flow_Event_start_Activity_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Activity_1" name="Senior Infrastructure Engineers">
      <bpmn:documentation>Applies to Tier 1 Support Agents, Incident Managers, Senior Infrastructure Engineers, and Quality Assurance Coordinators.</bpmn:documentation>
      <bpmn:incoming>Flow_Event_start_Activity_1</bpmn:incoming>
      <bpmn:outgoing>Flow_Activity_1_Activity_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_2" name="and preliminary classification.">
      <bpmn:documentation>- **Customer Support Agent (Tier 1)**: Initial triage, logging, and preliminary classification.</bpmn:documentation>
      <bpmn:incoming>Flow_Activity_1_Activity_2</bpmn:incoming>
      <bpmn:outgoing>Flow_Activity_2_Activity_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_3" name="post-incident review.">
      <bpmn:documentation>- **Incident Commander**: Escalation governance, stakeholder communication, post-incident review.</bpmn:documentation>
      <bpmn:incoming>Flow_Activity_2_Activity_3</bpmn:incoming>
      <bpmn:outgoing>Flow_Activity_3_Activity_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_4" name="patch deployment.">
      <bpmn:documentation>- **Site Reliability Engineer (SRE)**: Diagnostic investigation, failover execution, patch deployment.</bpmn:documentation>
      <bpmn:incoming>Flow_Activity_3_Activity_4</bpmn:incoming>
      <bpmn:outgoing>Flow_Activity_4_Activity_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_5" name="Customer Relationship Manager**: Client status briefings and">
      <bpmn:documentation>- **Customer Relationship Manager**: Client status briefings and executive SLA monitoring.</bpmn:documentation>
      <bpmn:incoming>Flow_Activity_4_Activity_5</bpmn:incoming>
      <bpmn:outgoing>Flow_Activity_5_Activity_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_6" name="The customer lodges an incident ticket via the support porta">
      <bpmn:documentation>1. The customer lodges an incident ticket via the support portal or emergency hotline.</bpmn:documentation>
      <bpmn:incoming>Flow_Activity_5_Activity_6</bpmn:incoming>
      <bpmn:outgoing>Flow_Activity_6_Activity_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_7" name="The Tier 1 Support Agent inspects the reported symptoms and ">
      <bpmn:documentation>2. The Tier 1 Support Agent inspects the reported symptoms and verifies the customer's SLA tier.</bpmn:documentation>
      <bpmn:incoming>Flow_Activity_6_Activity_7</bpmn:incoming>
      <bpmn:outgoing>Flow_Activity_7_Activity_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_8" name="Severity 1 (Critical Outage)**:">
      <bpmn:documentation>- **Condition: Severity 1 (Critical Outage)**:</bpmn:documentation>
      <bpmn:incoming>Flow_Activity_7_Activity_8</bpmn:incoming>
      <bpmn:outgoing>Flow_Activity_8_Activity_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_9" name="If service degradation impacts more than 10% of active users">
      <bpmn:documentation>- If service degradation impacts more than 10% of active users, the Tier 1 Agent triggers an immediate Sev-1 Page.</bpmn:documentation>
      <bpmn:incoming>Flow_Activity_8_Activity_9</bpmn:incoming>
      <bpmn:outgoing>Flow_Activity_9_Activity_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_10" name="The Incident Commander convenes an emergency bridge line wit">
      <bpmn:documentation>- The Incident Commander convenes an emergency bridge line with the SRE on call.</bpmn:documentation>
      <bpmn:incoming>Flow_Activity_9_Activity_10</bpmn:incoming>
      <bpmn:outgoing>Flow_Activity_10_Activity_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_11" name="The SRE conducts root-cause triage and executes service rest">
      <bpmn:documentation>- The SRE conducts root-cause triage and executes service restoration procedures.</bpmn:documentation>
      <bpmn:incoming>Flow_Activity_10_Activity_11</bpmn:incoming>
      <bpmn:outgoing>Flow_Activity_11_Activity_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_12" name="Upon successful mitigation, the Incident Commander publishes">
      <bpmn:documentation>- Upon successful mitigation, the Incident Commander publishes an incident resolution report.</bpmn:documentation>
      <bpmn:incoming>Flow_Activity_11_Activity_12</bpmn:incoming>
      <bpmn:outgoing>Flow_Activity_12_Activity_13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_13" name="Severity 2/3 (Standard Defect or Query)**:">
      <bpmn:documentation>- **Condition: Severity 2/3 (Standard Defect or Query)**:</bpmn:documentation>
      <bpmn:incoming>Flow_Activity_12_Activity_13</bpmn:incoming>
      <bpmn:outgoing>Flow_Activity_13_Activity_14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_14" name="If the issue does not halt production, the ticket is routed ">
      <bpmn:documentation>- If the issue does not halt production, the ticket is routed to the standard engineering backlog.</bpmn:documentation>
      <bpmn:incoming>Flow_Activity_13_Activity_14</bpmn:incoming>
      <bpmn:outgoing>Flow_Activity_14_Activity_15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_15" name="A developer prioritizes the fix for the next sprint cycle.">
      <bpmn:documentation>- A developer prioritizes the fix for the next sprint cycle.</bpmn:documentation>
      <bpmn:incoming>Flow_Activity_14_Activity_15</bpmn:incoming>
      <bpmn:outgoing>Flow_Activity_15_Activity_16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_16" name="The Tier 1 Agent verifies service resumption with the client">
      <bpmn:documentation>1. The Tier 1 Agent verifies service resumption with the client.</bpmn:documentation>
      <bpmn:incoming>Flow_Activity_15_Activity_16</bpmn:incoming>
      <bpmn:outgoing>Flow_Activity_16_Activity_17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_17" name="Once the client confirms satisfaction, the ticket is marked ">
      <bpmn:documentation>2. Once the client confirms satisfaction, the ticket is marked Resolved and the workflow terminates.</bpmn:documentation>
      <bpmn:incoming>Flow_Activity_16_Activity_17</bpmn:incoming>
      <bpmn:outgoing>Flow_Activity_17_Event_end</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="Event_end" name="End">
      <bpmn:incoming>Flow_Activity_17_Event_end</bpmn:incoming>
    </bpmn:endEvent>
