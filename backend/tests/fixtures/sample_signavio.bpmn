      </bpmn:lane>
      <bpmn:lane id="Lane_3" name="User">
        <bpmn:flowNodeRef>Activity_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Event_start" name="Start">
      <bpmn:outgoing>Flow_Event_start_Activity_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Activity_1" name="Submit Request">
      <bpmn:documentation>Employee initiates request</bpmn:documentation>
      <bpmn:incoming>Flow_Event_start_Activity_1</bpmn:incoming>
      <bpmn:outgoing>Flow_Activity_1_Activity_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="Activity_2" name="Review and Approve">
      <bpmn:documentation>Manager verifies justification</bpmn:documentation>
      <bpmn:incoming>Flow_Activity_1_Activity_2</bpmn:incoming>
      <bpmn:outgoing>Flow_Activity_2_Activity_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="Activity_3" name="Execute Processing">
      <bpmn:documentation>Automated system completes order</bpmn:documentation>
      <bpmn:incoming>Flow_Activity_2_Activity_3</bpmn:incoming>
      <bpmn:outgoing>Flow_Activity_3_Event_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Event_end" name="End">
      <bpmn:incoming>Flow_Activity_3_Event_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Event_start_Activity_1" sourceRef="Event_start" targetRef="Activity_1"/>
    <bpmn:sequenceFlow id="Flow_Activity_1_Activity_2" sourceRef="Activity_1" targetRef="Activity_2"/>
    <bpmn:sequenceFlow id="Flow_Activity_2_Activity_3" sourceRef="Activity_2" targetRef="Activity_3"/>
    <bpmn:sequenceFlow id="Flow_Activity_3_Event_end" sourceRef="Activity_3" targetRef="Event_end"/>
  </bpmn:process>
