    <bpmn:laneSet id="LaneSet_Process_1">
      <bpmn:lane id="Lane_1" name="Manager">
        <bpmn:flowNodeRef>Event_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="System">
