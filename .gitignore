*.py[cod]
*$py.class
.pytest_cache/

# Environment Variables & Secrets
.env
.env.local
.env.*.local

# Dynamic User Templates and per-user preferences
data/templates/tpl_*
data/templates/_prefs/

# Real-model re-validation output (scope v2 phase 7)
revalidation/

# OS & Editor files
.DS_Store
Thumbs.db
*.log
fixes.patch
converted/
