# ==============================================================================
# Process2BPMN configuration  (copy to .env — the server reads it at startup)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application settings
# ------------------------------------------------------------------------------
# SINGLE_POOL=true merges every participant into one pool with swimlanes (safest for
# Signavio / ARIS / Celonis imports). false = one pool per participant with message flows.
SINGLE_POOL=true
PORT=8000
VITE_PORT=3000
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 2. Language model — pick ONE block below, fill in the values, delete the others
#    Provider names: openai_compatible | ollama | anthropic | gemini | azure | mock
#    Restart the server after editing (make dev / make run).
#    The UI's Settings sheet can override these per session without touching this file.
# ------------------------------------------------------------------------------

# --- Google Gemini (hosted, needs a key from https://aistudio.google.com/apikey) ---
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta
LLM_API_KEY=your-gemini-key
LLM_CONTEXT_TOKENS=100000

# --- Ollama (free, offline; install from https://ollama.com then `ollama pull llama3.1`) ---
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.1
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# Keep this at or below Ollama's context window: it silently truncates prompts beyond num_ctx
# (default 4096 on most models). Either lower this or start Ollama with OLLAMA_CONTEXT_LENGTH=8192.
# LLM_CONTEXT_TOKENS=4096
# LLM_TIMEOUT=300

# --- OpenAI / Groq / Mistral / OpenRouter / vLLM (any OpenAI-compatible endpoint) ---
# LLM_PROVIDER=openai_compatible
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_CONTEXT_TOKENS=128000

# --- Azure OpenAI (full deployment URL; key goes in the api-key header) ---
# LLM_PROVIDER=azure
# LLM_MODEL=gpt-4o
# LLM_BASE_URL=https://<resource>.openai.azure.com/openai/deployments/<deployment>/chat/completions?api-version=2024-10-21
# LLM_API_KEY=...
# LLM_AUTH_HEADER=api-key
# LLM_CONTEXT_TOKENS=128000

# --- Anthropic Claude ---
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-4-5
# LLM_BASE_URL=https://api.anthropic.com/v1
# LLM_API_KEY=sk-ant-...
# LLM_CONTEXT_TOKENS=200000

# --- Mock (no model; only for testing the pipeline and importers) ---
# LLM_PROVIDER=mock

# Optional tuning
# LLM_MAX_OUTPUT_TOKENS=4096
# LLM_TEMPERATURE=0.1
# Seconds to wait for one model response (default 90). Raise this for local models on CPU,
# e.g. LLM_TIMEOUT=300 for Ollama; a 4k-token JSON answer from an 8B model can take minutes.
# LLM_TIMEOUT=90

# ------------------------------------------------------------------------------
# 3. Multi-user deployment (leave everything unset for a single-user laptop setup)
# ------------------------------------------------------------------------------
# APP_AUTH_MODE: none | proxy | token
#   none  - no authentication, everyone is the same "local" user (default)
#   proxy - trust the identity header set by your reverse proxy / SSO gateway
#           (oauth2-proxy, Cloudflare Access, Traefik ForwardAuth, Nginx auth_request)
#   token - shared secret sent as "Authorization: Bearer <APP_API_TOKEN>"; identity from X-User-Id
# APP_AUTH_MODE=proxy
# APP_AUTH_HEADER=X-Forwarded-User
# APP_API_TOKEN=change-me-to-a-long-random-string
# APP_USER_ID_HEADER=X-User-Id

# When the app is shared, one server key is normally used for everyone. Set this to false to
# ignore per-request provider/model/base_url/api_key overrides from the Settings sheet
# (the "Rule engine" option still works). Default: true.
# ALLOW_CLIENT_LLM_OVERRIDES=false

# SSRF protection for client-supplied model endpoints. Private/loopback addresses (e.g. a
# local Ollama) are allowed only when APP_AUTH_MODE=none unless you override it here.
# LLM_ALLOW_PRIVATE_BASE_URLS=false
# LLM_BASE_URL_ALLOWLIST=api.openai.com,api.anthropic.com,generativelanguage.googleapis.com

# Show base URL / masked key hint on /api/health (default: only when APP_AUTH_MODE=none)
# EXPOSE_SERVER_CONFIG=false

# Throttling. Rate limit defaults to 30/min per user when auth is on, unlimited otherwise.
# RATE_LIMIT_PER_MINUTE=30
# MAX_CONCURRENT_EXTRACTIONS=4
# EXTRACTION_QUEUE_TIMEOUT_SECONDS=30

# Browsers only need CORS if the UI is served from a different origin than the API.
# CORS_ALLOW_ORIGINS=https://process.example.com

# Upload size limit in bytes (default 20 MB)
# MAX_UPLOAD_SIZE_BYTES=20971520
