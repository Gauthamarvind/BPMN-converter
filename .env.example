# ==============================================================================
# Process2BPMN configuration  (copy to .env — the server reads it at startup)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application settings
# ------------------------------------------------------------------------------
# SINGLE_POOL=true merges every participant into one pool with swimlanes (safest for
# Signavio / ARIS / Celonis imports). false = one pool per participant with message flows.
SINGLE_POOL=true
PORT=8000
VITE_PORT=3000
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 2. Language model — pick ONE block below, fill in the values, delete the others
#    Provider names: openai_compatible | ollama | anthropic | gemini | azure | mock
#    Restart the server after editing (make dev / make run).
#    The UI's Settings sheet can override these per session without touching this file.
# ------------------------------------------------------------------------------

# --- Google Gemini (hosted, needs a key from https://aistudio.google.com/apikey) ---
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta
LLM_API_KEY=your-gemini-key
LLM_CONTEXT_TOKENS=100000

# --- Ollama (free, offline; install from https://ollama.com then `ollama pull llama3.1`) ---
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.1
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_CONTEXT_TOKENS=8192

# --- OpenAI / Groq / Mistral / OpenRouter / vLLM (any OpenAI-compatible endpoint) ---
# LLM_PROVIDER=openai_compatible
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_CONTEXT_TOKENS=128000

# --- Azure OpenAI (full deployment URL; key goes in the api-key header) ---
# LLM_PROVIDER=azure
# LLM_MODEL=gpt-4o
# LLM_BASE_URL=https://<resource>.openai.azure.com/openai/deployments/<deployment>/chat/completions?api-version=2024-10-21
# LLM_API_KEY=...
# LLM_AUTH_HEADER=api-key
# LLM_CONTEXT_TOKENS=128000

# --- Anthropic Claude ---
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-4-5
# LLM_BASE_URL=https://api.anthropic.com/v1
# LLM_API_KEY=sk-ant-...
# LLM_CONTEXT_TOKENS=200000

# --- Mock (no model; only for testing the pipeline and importers) ---
# LLM_PROVIDER=mock

# Optional tuning
# LLM_MAX_OUTPUT_TOKENS=4096
# LLM_TEMPERATURE=0.1
